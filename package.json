{
  "name": "@tronweb3/tviem",
  "version": "1.0.0-beta.1",
  "description": "Lightweight, type-safe TypeScript SDK for the TRON blockchain",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "keywords": [
    "tron",
    "trx",
    "sdk",
    "trc20",
    "web3",
    "typescript",
    "tvm"
  ],
  "homepage": "https://github.com/tronweb3/tviem#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tronweb3/tviem.git"
  },
  "bugs": {
    "url": "https://github.com/tronweb3/tviem/issues"
  },
  "main": "./src/_cjs/index.js",
  "module": "./src/_esm/index.js",
  "types": "./src/_types/index.d.ts",
  "typings": "./src/_types/index.d.ts",
  "files": [
    "src/_esm",
    "src/_cjs",
    "src/_types",
    "!**/*.test.ts",
    "!**/*.test-d.ts",
    "!**/*.bench.ts",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./src/_types/index.d.ts",
        "default": "./src/_esm/index.js"
      },
      "require": {
        "types": "./src/_cjs/index.d.ts",
        "default": "./src/_cjs/index.js"
      }
    },
    "./accounts": {
      "import": {
        "types": "./src/_types/accounts/index.d.ts",
        "default": "./src/_esm/accounts/index.js"
      },
      "require": {
        "types": "./src/_cjs/accounts/index.d.ts",
        "default": "./src/_cjs/accounts/index.js"
      }
    },
    "./actions": {
      "import": {
        "types": "./src/_types/actions/index.d.ts",
        "default": "./src/_esm/actions/index.js"
      },
      "require": {
        "types": "./src/_cjs/actions/index.d.ts",
        "default": "./src/_cjs/actions/index.js"
      }
    },
    "./chains": {
      "import": {
        "types": "./src/_types/chains/index.d.ts",
        "default": "./src/_esm/chains/index.js"
      },
      "require": {
        "types": "./src/_cjs/chains/index.d.ts",
        "default": "./src/_cjs/chains/index.js"
      }
    },
    "./utils": {
      "import": {
        "types": "./src/_types/utils/index.d.ts",
        "default": "./src/_esm/utils/index.js"
      },
      "require": {
        "types": "./src/_cjs/utils/index.d.ts",
        "default": "./src/_cjs/utils/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "accounts": [
        "./src/_types/accounts/index.d.ts"
      ],
      "actions": [
        "./src/_types/actions/index.d.ts"
      ],
      "chains": [
        "./src/_types/chains/index.d.ts"
      ],
      "utils": [
        "./src/_types/utils/index.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "typescript": ">=5.4.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0",
    "abitype": "1.2.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@biomejs/biome": "2.5.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "knip": "5.88.1",
    "publint": "0.3.22",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "scripts": {
    "clean": "rm -rf *.tsbuildinfo src/*.tsbuildinfo src/_esm src/_cjs src/_types",
    "build": "pnpm clean && pnpm build:cjs && pnpm build:esm && pnpm build:types && pnpm build:types:cjs",
    "build:esm": "tsc --project ./tsconfig.build.json --outDir ./src/_esm && printf '{\"type\":\"module\",\"sideEffects\":false}' > ./src/_esm/package.json",
    "build:cjs": "node scripts/runTsc.js --project ./tsconfig.build.json --module commonjs --moduleResolution node --outDir ./src/_cjs --removeComments --verbatimModuleSyntax false && printf '{\"type\":\"commonjs\",\"sideEffects\":false}' > ./src/_cjs/package.json",
    "build:types": "tsc --project ./tsconfig.build.json --declarationDir ./src/_types --emitDeclarationOnly --declaration --declarationMap",
    "build:types:cjs": "tsc --project ./tsconfig.build.json --declarationDir ./src/_cjs --emitDeclarationOnly --declaration",
    "preconstruct": "node scripts/preconstruct.mjs",
    "check": "biome check --write --unsafe",
    "check:types": "tsc --noEmit --project ./tsconfig.json",
    "check:unused": "pnpm clean && knip --production",
    "test": "vitest --project unit",
    "test:typecheck": "vitest --typecheck.only",
    "test:build": "cd src && publint --strict . && attw --pack . --ignore-rules false-esm"
  },
  "knip": {
    "entry": [
      "src/index.ts!",
      "src/{accounts,actions,chains,utils}/index.ts!"
    ],
    "project": [
      "src/**/*.ts!",
      "test/**/*.ts",
      "scripts/*.{ts,mjs,js}"
    ],
    "ignoreExportsUsedInFile": true,
    "ignore": [
      "**/*.test.ts",
      "**/*.test-d.ts",
      "**/*.e2e.test.ts",
      "src/errors/utils.ts",
      "src/utils/transaction/contracts/**",
      "src/utils/transaction/protobuf/**"
    ]
  }
}
