{
  // Build config for the ESM + types emit (see package.json `build:esm` / `build:types`).
  // Excludes all test/bench files.
  "extends": "./tsconfig.base.json",
  "include": ["src"],
  "exclude": [
    "src/**/*.bench.ts",
    "src/**/*.bench-d.ts",
    "src/**/*.test.ts",
    "src/**/*.test-d.ts"
  ],
  "compilerOptions": {
    // The package is published from `src/` (viem-style): the `.ts` sources ship
    // alongside the artifacts (src/package.json `files: ["*"]`), so `build:types`
    // emits `--declarationMap` and the `.d.ts.map` files resolve to the shipped
    // sources for go-to-definition. rootDir keeps the emit rooted at `src/`.
    "rootDir": "./src"
  }
}
