{
  // Build config for the ESM + types emit (see package.json `build:esm` / `build:types`).
  // Excludes all test/bench files.
  "extends": "./tsconfig.base.json",
  "include": ["src"],
  "exclude": [
    "src/**/*.bench.ts",
    "src/**/*.bench-d.ts",
    "src/**/*.test.ts",
    "src/**/*.test-d.ts"
  ],
  "compilerOptions": {
    // The package is published from `src/` (viem-style): the `.ts` sources ship
    // alongside the artifacts (src/package.json `files: ["*"]`), so the emitted
    // maps resolve to the shipped sources. `sourceMap` gives `_esm`/`_cjs` their
    // `.js.map` (runtime debugging); `build:types --declarationMap` gives
    // `_types` its `.d.ts.map` (go-to-definition). rootDir roots the emit at `src/`.
    "sourceMap": true,
    "rootDir": "./src"
  }
}
